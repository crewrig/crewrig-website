---
import { Image } from 'astro:assets';
import type { Case } from '../data/cases';

interface Props {
  case: Case;
  /** Zero-based position in the case list — drives image side and load strategy. */
  index: number;
}

const { case: c, index } = Astro.props;

// Astro requires a statically-analysable glob to resolve `src/assets` imports
// from a runtime-provided filename.
const illustrations = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/illustrations/*.png',
);
const importer = illustrations[`../assets/illustrations/${c.illustration.file}`];
if (!importer) {
  throw new Error(
    `Case "${c.id}": illustration "${c.illustration.file}" not found under src/assets/illustrations/`,
  );
}
const illustration = (await importer()).default;

const isFirst = index === 0;
// Alternate the image to the right on even cases, left on odd cases.
const imageOnRight = index % 2 === 0;

const bgClass = index % 2 === 0 ? 'bg-[#0d0d14]' : 'bg-[#16161f]';
---

<section
  id={`case-${c.id}`}
  data-testid="case"
  class:list={['section', bgClass]}
>
  <div class="section-wide">
    <div
      class:list={[
        'grid items-center gap-10 lg:grid-cols-2 lg:gap-16',
        imageOnRight ? '' : 'lg:[&>figure]:order-last',
      ]}
    >
      <div data-aos={isFirst ? undefined : 'fade-up'}>
        <p class="text-sm font-semibold uppercase tracking-widest text-[#a5b4fc]">
          {c.pillar}
        </p>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-[#f0f0f6] sm:text-4xl"
        >
          {c.title}
        </h2>

        <p class="mt-5 text-base text-[#9090a8]">
          <span class="font-semibold text-[#f0f0f6]">{c.persona.name}</span>
          <span class="text-[#9090a8]"> — {c.persona.role}</span>
        </p>

        <div class="mt-6 space-y-5">
          <p class="text-lg leading-relaxed text-[#c4c4d4]">{c.problem}</p>
          <p
            class="border-l-2 border-[#7c3aed] pl-4 text-lg leading-relaxed text-[#f0f0f6]"
          >
            {c.solution}
          </p>
        </div>
      </div>

      <figure class="min-w-0" data-aos={isFirst ? undefined : 'fade-up'}>
        <Image
          src={illustration}
          alt={c.illustration.alt}
          width={1200}
          height={800}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          format="webp"
          loading={isFirst ? 'eager' : 'lazy'}
          class="w-full rounded-xl border border-[#7c3aed]/20 shadow-2xl shadow-[#7c3aed]/10"
        />
      </figure>
    </div>
  </div>
</section>
